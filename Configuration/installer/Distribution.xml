<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Notchscape</title>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <volume-check script="true">
        <allowed-os-versions>
            <os-version min="15.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="notchscape"/>
    </choices-outline>
    <choice id="notchscape" title="Notchscape" visible="false">
        <pkg-ref id="com.notchscape.installer.app"/>
    </choice>
    <pkg-ref id="com.notchscape.installer.app">Notchscape-component.pkg</pkg-ref>
</installer-gui-script>
